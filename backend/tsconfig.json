{
	"compilerOptions": {
	  "module": "commonjs",
	  "target": "ES2020",
	  "strict": true,
	  "strictPropertyInitialization": false,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "emitDecoratorMetadata": true,
	  "experimentalDecorators": true,
	  "sourceMap": true,
	  "outDir": "./dist",
	  "baseUrl": "./",
	  "incremental": true,
	  "types": ["node"],
	  "paths": {
		"src/*": ["./src/*"]
	  }
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
  }
  