{
	"compilerOptions": {
	  "target": "ES2020",
	  "module": "commonjs",
	  "strict": true,
	  "esModuleInterop": true,
	  "skipLibCheck": true,
	  "forceConsistentCasingInFileNames": true,
	  "outDir": "./dist",
	  "rootDir": ".",
	  "resolveJsonModule": true,
	  "experimentalDecorators": true,
	  "emitDecoratorMetadata": true
	},
	"include": ["**/*"],
	"exclude": ["node_modules", "**/*.spec.ts"]
  }
  